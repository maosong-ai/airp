{
  "name": "@airp/writer",
  "version": "1.1.4",
  "author": "毛松 <maosong-life@outlook.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./to-disk": {
      "types": "./src/node/to-disk.ts",
      "import": "./src/node/to-disk.ts",
      "node": "./src/node/to-disk.ts"
    },
    "./to-memory": {
      "types": "./src/to-memory.ts",
      "import": "./src/to-memory.ts",
      "default": "./src/to-memory.ts"
    },
    "./noop": {
      "types": "./src/noop.ts",
      "import": "./src/noop.ts",
      "default": "./src/noop.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm dlx ultracite@7.4.2 check",
    "fix": "pnpm typecheck && pnpm dlx ultracite@7.4.2 fix"
  },
  "dependencies": {
    "@airp/utils": "workspace:*"
  },
  "devDependencies": {
    "@airp/typescript-config": "workspace:*",
    "vitest": "4.1.11"
  }
}
