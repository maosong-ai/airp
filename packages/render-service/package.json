{
  "name": "@airp/render-service",
  "version": "1.1.3",
  "author": "毛松 <maosong-life@outlook.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./src/vite.ts",
      "default": "./src/vite.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm dlx ultracite@7.4.2 check",
    "fix": "pnpm typecheck && pnpm dlx ultracite@7.4.2 fix"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@airp/renderer": "workspace:*",
    "@airp/test-kit": "workspace:*",
    "@airp/typescript-config": "workspace:*",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
