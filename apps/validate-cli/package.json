{
  "name": "@airp/validate-cli",
  "version": "1.1.4",
  "description": "Validate an AIRP document (*.airp.json)",
  "author": "毛松 <maosong-life@outlook.com>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "airp-validate": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx bin/dev.ts",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:cli": "vitest run test/cli.test.ts",
    "check": "pnpm typecheck && pnpm dlx ultracite@7.4.2 check",
    "fix": "pnpm typecheck && pnpm dlx ultracite@7.4.2 fix"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "citty": "^0.2.2",
    "jsdom": "^26.1.0",
    "mermaid": "11.12.0"
  },
  "devDependencies": {
    "@airp/diagnostics": "workspace:*",
    "@airp/loader": "workspace:*",
    "@airp/test-kit": "workspace:*",
    "@airp/typescript-config": "workspace:*",
    "@airp/utils": "workspace:*",
    "@airp/validate": "workspace:*",
    "@types/jsdom": "^21.1.7",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "vitest": "4.1.11"
  }
}
